+class OpenAICompatible(OpenAI):
+    @property
+    def metadata(self) -> LLMMetadata:
+        try:
+            context_window = openai_modelname_to_contextsize(self._get_model_name())
+            is_known_chat_model = is_chat_model(model=self._get_model_name())
