diff --git a/Orcar/output_parser.py b/Orcar/output_parser.py
index 3b2fa04..705df55 100644
--- a/Orcar/output_parser.py
+++ b/Orcar/output_parser.py
@@ -116,8 +116,26 @@ def load_with_escape(input_text: str) -> dict:
     # Apply the regex with the replacement function
     input_text = re.sub(pattern, replace_match, input_text)
 
-    # Parse JSON
-    data = json.loads(input_text)
+    # Parse JSON. Some OpenAI-compatible models may emit two adjacent JSON
+    # objects despite response_format=json_object; use the semantic object.
+    try:
+        data = json.loads(input_text)
+    except json.JSONDecodeError as exc:
+        decoder = json.JSONDecoder()
+        parsed_objects = []
+        for match in re.finditer(r"\{", input_text):
+            try:
+                parsed_object, _ = decoder.raw_decode(input_text, match.start())
+            except json.JSONDecodeError:
+                continue
+            if isinstance(parsed_object, dict):
+                parsed_objects.append(parsed_object)
+        for parsed_object in reversed(parsed_objects):
+            if "observation_feedback" in parsed_object:
+                return parsed_object
+        if not parsed_objects:
+            raise exc
+        data = parsed_objects[-1]
 
     return data
 
